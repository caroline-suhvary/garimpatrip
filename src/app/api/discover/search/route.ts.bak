// GET /api/discover/search?origin=...&destination=...&month=AAAA-MM
// Busca unificada para a tela Descobrir: agrega voos, hospedagem e passeios em paralelo
import { NextResponse } from 'next/server';
import { searchFlights, searchHotels, searchTours, searchTransport } from '@/lib/providers';
import type { SearchResult } from '@/types';

function clean(value: string | null, max = 80): string {
  return (value ?? '').replace(/[<>]/g, '').trim().slice(0, max);
}

export async function GET(request: Request) {
  const { searchParams } = new URL(request.url);
  const destination = clean(searchParams.get('destination'));
  const origin = clean(searchParams.get('origin'));
  const month = clean(searchParams.get('month'), 7);

  if (destination.length < 2) {
    return NextResponse.json({ error: 'Informe o destino.', results: [] }, { status: 400 });
  }

  try {
    const [flightsRes, hotelsRes, toursRes, transportRes] = await Promise.allSettled([
      origin.length >= 2 ? searchFlights(origin, destination, month || undefined) : Promise.resolve({ results: [] }),
      searchHotels(destination),
      searchTours(destination),
      searchTransport(destination),
    ]);

    const results: SearchResult[] = [];

    if (flightsRes.status === 'fulfilled' && flightsRes.value?.results) {
      results.push(...flightsRes.value.results);
    }
    if (hotelsRes.status === 'fulfilled' && hotelsRes.value?.results) {
      results.push(...hotelsRes.value.results);
    }
    if (toursRes.status === 'fulfilled' && toursRes.value?.results) {
      results.push(...toursRes.value.results);
    }
    if (transportRes.status === 'fulfilled' && transportRes.value?.results) {
      results.push(...transportRes.value.results);
    }

    return NextResponse.json({
      results,
      destination,
      origin,
      month,
      count: results.length,
    });
  } catch (err: any) {
    return NextResponse.json(
      { error: 'Falha ao buscar ofertas nos provedores.', results: [] },
      { status: 500 }
    );
  }
}
