'use client';
// Barra de navegação: links das telas, login com Google e menu para celular.
import React, { useState } from 'react';
import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { Compass, Sparkles, User, Globe, TrendingDown, LogOut, Menu, X, Briefcase, Map } from 'lucide-react';
import { useAuth } from '@/hooks/useAuth';
import styles from '@/styles/Navbar.module.css';

const LINKS = [
  { href: '/discover', label: 'Descobrir Destinos', icon: Map },
  { href: '/box', label: 'Caixa de Descobertas', icon: Sparkles },
  { href: '/package', label: 'Meu Pacote (10 Áreas)', icon: Briefcase },
  { href: '/radar', label: 'Radar de Preços', icon: TrendingDown },
  { href: '/trips', label: 'Minhas Viagens', icon: Compass },
];

export const Navbar = () => {
  const pathname = usePathname();
  const { user, loading, signIn, signOut } = useAuth();
  const [open, setOpen] = useState(false);

  const name = (user?.user_metadata?.full_name as string | undefined) ?? user?.email ?? '';
  const avatar = user?.user_metadata?.avatar_url as string | undefined;

  return (
    <header className={styles.header}>
      <div className={styles.container}>
        <Link href="/" className={styles.logo} onClick={() => setOpen(false)}>
          <div className={styles.logoIcon}>
            <Compass size={24} strokeWidth={2.5} />
          </div>
          <span className={styles.logoText}>
            Garimpa<span className={styles.logoHighlight}>Trip</span>
          </span>
        </Link>

        <nav className={`${styles.nav} ${open ? styles.navOpen : ''}`} aria-label="Principal">
          {LINKS.map(({ href, label, icon: Icon }) => (
            <Link
              key={href}
              href={href}
              onClick={() => setOpen(false)}
              className={`${styles.navLink} ${pathname?.startsWith(href) ? styles.navLinkActive : ''}`}
            >
              <Icon size={16} />
              {label}
            </Link>
          ))}
        </nav>

        <div className={styles.actions}>
          <span className={styles.langBtn} title="Idioma do site">
            <Globe size={14} />
            <span>PT-BR</span>
          </span>

          {user ? (
            <div className={styles.userBox}>
              {avatar ? (
                // eslint-disable-next-line @next/next/no-img-element
                <img src={avatar} alt={name} className={styles.avatar} referrerPolicy="no-referrer" />
              ) : (
                <span className={styles.avatar}>{name.slice(0, 1).toUpperCase()}</span>
              )}
              <button type="button" className={styles.logoutBtn} onClick={signOut} aria-label="Sair" title="Sair">
                <LogOut size={16} />
              </button>
            </div>
          ) : (
            <button type="button" className={styles.loginBtn} onClick={signIn} disabled={loading}>
              <User size={16} />
              <span className={styles.loginLabel}>Entrar com Google</span>
            </button>
          )}

          <button
            type="button"
            className={styles.menuBtn}
            onClick={() => setOpen((v) => !v)}
            aria-label={open ? 'Fechar menu' : 'Abrir menu'}
            aria-expanded={open}
          >
            {open ? <X size={20} /> : <Menu size={20} />}
          </button>
        </div>
      </div>
    </header>
  );
};
