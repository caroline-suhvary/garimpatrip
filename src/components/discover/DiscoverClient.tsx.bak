'use client';
import React, { useState, useEffect } from 'react';
import Link from 'next/link';
import { useSearchParams } from 'next/navigation';
import {
  Search, Plus, Sparkles, ExternalLink, Compass, AlertCircle, Check, Loader2,
  Plane, Building2, Ticket, Bus, Globe, MapPin, DollarSign, Calendar
} from 'lucide-react';
import { useAuth } from '@/hooks/useAuth';
import { useTrips } from '@/hooks/useTrips';
import { TripPicker } from '@/components/TripPicker';
import { AutocompleteInput } from '@/components/search/AutocompleteInput';
import { cityName } from '@/lib/iata';
import { formatBRL } from '@/lib/format';
import type { SearchResult } from '@/types';
import styles from '@/styles/Discover.module.css';

interface DiscoverData {
  flights: { results: SearchResult[]; notice?: string };
  hotels: { results: SearchResult[]; notice?: string };
  tours: { results: SearchResult[]; notice?: string };
  transport: { results: SearchResult[]; notice?: string };
}

interface DiscoverClientProps {
  initialOrigin?: string;
  initialDestination?: string;
  initialBudget?: string;
  initialMonth?: string;
}

export function DiscoverClient({
  initialOrigin = '',
  initialDestination = '',
  initialBudget = '3500',
  initialMonth = '',
}: DiscoverClientProps) {
  const searchParams = useSearchParams();
  const { supabase, user, signIn } = useAuth();
  const { trips, selectedTrip, selectedId, setSelectedId, reload, loading: tripsLoading } = useTrips(supabase, user);

  const paramOrigin = searchParams.get('origin') || initialOrigin || 'São Paulo (GRU)';
  const paramDest = searchParams.get('destination') || initialDestination || '';
  const paramMonth = searchParams.get('month') || initialMonth || '';
  const paramBudget = searchParams.get('budget') || initialBudget || '3500';

  const [origin, setOrigin] = useState(paramOrigin);
  const [destination, setDestination] = useState(paramDest);
  const [month, setMonth] = useState(paramMonth);
  const [budget, setBudget] = useState(paramBudget);

  const [data, setData] = useState<DiscoverData | null>(null);
  const [activeTab, setActiveTab] = useState<'all' | 'flights' | 'transport' | 'hotels' | 'tours' | 'web'>('all');
  const [searching, setSearching] = useState(false);
  const [searched, setSearched] = useState<{ origin: string; destination: string; month: string } | null>(null);

  const [savedUrls, setSavedUrls] = useState<Set<string>>(new Set());
  const [message, setMessage] = useState<{ type: 'ok' | 'error'; text: string } | null>(null);
  const [creatingTrip, setCreatingTrip] = useState(false);

  const [manualTitle, setManualTitle] = useState('');
  const [manualUrl, setManualUrl] = useState('');

  const runSearch = async (orig: string, dest: string, m: string) => {
    setSearching(true);
    setMessage(null);
    try {
      const qs = new URLSearchParams({ origin: orig, destination: dest });
      if (m && m.trim().length > 0) qs.set('month', m.trim());
      const res = await fetch(`/api/discover/search?${qs.toString()}`);
      if (!res.ok) throw new Error('Não foi possível carregar as opções de garimpo.');
      const json = await res.json();
      setData(json);
    } catch (err: any) {
      setMessage({ type: 'error', text: err.message || 'Erro ao garimpar opções.' });
    } finally {
      setSearching(false);
    }
  };

  useEffect(() => {
    if (paramDest && paramDest.trim().length > 0) {
      setOrigin(paramOrigin);
      setDestination(paramDest);
      setMonth(paramMonth);
      setBudget(paramBudget);
      setSearched({ origin: paramOrigin, destination: paramDest, month: paramMonth });
      runSearch(paramOrigin, paramDest, paramMonth);
    }
  }, [paramDest, paramOrigin, paramMonth, paramBudget]);

  const handleSearchSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!destination.trim()) {
      return setMessage({ type: 'error', text: 'Informe um destino para pesquisar.' });
    }
    setSearched({ origin, destination, month });
    runSearch(origin, destination, month);
  };

  const handleAddToBox = async (item: SearchResult) => {
    if (!user) {
      setMessage({ type: 'error', text: 'Entre com sua conta Google para salvar itens na Caixa de Descobertas.' });
      return;
    }
    let tripId = selectedId;
    if (!tripId) {
      if (trips.length > 0) {
        tripId = trips[0].id;
        setSelectedId(tripId);
      } else {
        setCreatingTrip(true);
        try {
          const destName = destination.trim() || 'Minha Viagem';
          const { data: newTrip, error } = await supabase
            .from('trips')
            .insert({
              user_id: user.id,
              title: `Roteiro: ${destName}`,
              destination: destName,
              start_date: month ? `${month}-01` : null,
              budget_limit: budget ? Number(budget) : 3500,
              status: 'planning',
            })
            .select()
            .single();

          if (error) throw error;
          await reload();
          tripId = newTrip.id;
          setSelectedId(tripId);
        } catch (err: any) {
          setCreatingTrip(false);
          return setMessage({ type: 'error', text: `Não foi possível criar a viagem: ${err.message}` });
        } finally {
          setCreatingTrip(false);
        }
      }
    }

    try {
      const { error } = await supabase.from('box_items').insert({
        trip_id: tripId,
        user_id: user.id,
        category: item.category,
        title: item.title,
        notes: item.description || null,
        estimated_price: item.price ?? null,
        url: item.url || null,
        source: item.source || 'GarimpaTrip',
        status: 'idea',
      });
      if (error) throw error;
      setSavedUrls((prev) => new Set(prev).add(item.id || item.url));
      setMessage({ type: 'ok', text: `"${item.title}" foi salvo na sua Caixa!` });
    } catch (err: any) {
      setMessage({ type: 'error', text: `Erro ao salvar: ${err.message}` });
    }
  };

  const cleanDest = destination ? cityName(destination) : 'Destino';
  const cleanOrigin = origin ? cityName(origin) : 'Origem';

  const slugifyBus = (text: string) =>
    text
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');

  const origSlug = slugifyBus(cleanOrigin.split(',')[0]);
  const destSlug = slugifyBus(cleanDest.split(',')[0]);

  const busLinks = {
    clickbus: `https://www.clickbus.com.br/onibus/${origSlug}-para-${destSlug}`,
    deonibus: `https://deonibus.com/passagens-de-onibus/${origSlug}-${destSlug}`,
    buser: `https://www.buser.com.br/onibus/${origSlug}-${destSlug}`,
    rome2rio: `https://www.rome2rio.com/pt/map/${encodeURIComponent(cleanOrigin)}/${encodeURIComponent(cleanDest)}`,
  };

  const flightsList = data?.flights.results || [];
  const hotelsList = data?.hotels.results || [];
  const toursList = data?.tours.results || [];

  return (
    <main className={styles.main}>
      <section className={styles.searchSection}>
        <div className={styles.searchHeader}>
          <div className={styles.badgeTop}>
            <Compass size={14} />
            <span>Garimpo Multi-Provedores</span>
          </div>
          <h1 className={styles.title}>Descobrir Destinos & Oportunidades</h1>
        </div>

        <form onSubmit={handleSearchSubmit} className={styles.searchForm}>
          <div className={styles.inputsGrid}>
            <AutocompleteInput
              id="discover-origin"
              label="Origem"
              value={origin}
              onChange={setOrigin}
              placeholder="Ex: São Paulo"
              icon={<MapPin size={18} color="#6B7280" />}
            />

            <AutocompleteInput
              id="discover-destination"
              label="Destino"
              value={destination}
              onChange={setDestination}
              placeholder="Ex: Bonito, Paraty, Salvador"
              required
              icon={<Search size={18} color="#F5B731" />}
            />

            <div className={styles.inputField}>
              <Calendar size={18} color="#3B82F6" />
              <div className={styles.inputContent}>
                <label className={styles.inputLabel} htmlFor="discover-month">Mês da Viagem (Opcional)</label>
                <input
                  id="discover-month"
                  type="month"
                  value={month}
                  onChange={(e) => setMonth(e.target.value)}
                  className={styles.textInput}
                />
              </div>
            </div>

            <div className={styles.inputField}>
              <DollarSign size={18} color="#10B981" />
              <div className={styles.inputContent}>
                <label className={styles.inputLabel} htmlFor="discover-budget">Teto Estimado (R$)</label>
                <input
                  id="discover-budget"
                  type="number"
                  min={0}
                  value={budget}
                  onChange={(e) => setBudget(e.target.value)}
                  className={styles.textInput}
                  placeholder="Ex: 3500"
                />
              </div>
            </div>
          </div>

          <div className={styles.actionRow}>
            <button type="submit" className={styles.searchBtn} disabled={searching}>
              {searching ? (
                <>
                  <Loader2 size={18} className={styles.spin} />
                  <span>Garimpando...</span>
                </>
              ) : (
                <>
                  <Search size={18} />
                  <span>Garimpar Agora</span>
                </>
              )}
            </button>
          </div>
        </form>

        {user && (
          <div className={styles.tripPickerRow}>
            <TripPicker
              trips={trips}
              selectedId={selectedId}
              onSelect={setSelectedId}
              loading={tripsLoading || creatingTrip}
            />
          </div>
        )}

        {message && (
          <div className={`${styles.feedback} ${message.type === 'ok' ? styles.feedbackOk : styles.feedbackError}`}>
            {message.type === 'ok' ? <Check size={18} /> : <AlertCircle size={18} />}
            <span>{message.text}</span>
          </div>
        )}
      </section>

      {data && (
        <div className={styles.resultsArea}>
          <nav className={styles.navTabs}>
            <button
              type="button"
              className={`${styles.tabBtn} ${activeTab === 'all' ? styles.tabActive : ''}`}
              onClick={() => setActiveTab('all')}
            >
              Todos os Resultados
            </button>
            <button
              type="button"
              className={`${styles.tabBtn} ${activeTab === 'flights' ? styles.tabActive : ''}`}
              onClick={() => setActiveTab('flights')}
            >
              <Plane size={16} /> Voos
            </button>
            <button
              type="button"
              className={`${styles.tabBtn} ${activeTab === 'transport' ? styles.tabActive : ''}`}
              onClick={() => setActiveTab('transport')}
            >
              <Bus size={16} /> Ônibus & Rotas
            </button>
            <button
              type="button"
              className={`${styles.tabBtn} ${activeTab === 'hotels' ? styles.tabActive : ''}`}
              onClick={() => setActiveTab('hotels')}
            >
              <Building2 size={16} /> Hospedagens
            </button>
            <button
              type="button"
              className={`${styles.tabBtn} ${activeTab === 'tours' ? styles.tabActive : ''}`}
              onClick={() => setActiveTab('tours')}
            >
              <Ticket size={16} /> Passeios
            </button>
            <button
              type="button"
              className={`${styles.tabBtn} ${activeTab === 'web' ? styles.tabActive : ''}`}
              onClick={() => setActiveTab('web')}
            >
              <Globe size={16} /> Garimpo Livre
            </button>
          </nav>

          {/* 1. VOOS */}
          {(activeTab === 'all' || activeTab === 'flights') && (
            <section className={styles.categorySection}>
              <div className={styles.sectionHeader}>
                <div className={styles.sectionTitleGroup}>
                  <Plane size={22} className={styles.sectionIconFlight} />
                  <h2 className={styles.sectionTitle}>Voos & Passagens Aéreas</h2>
                </div>
                <span className={styles.sectionBadge}>Google Flights & Aviasales (BRL)</span>
              </div>

              {data.flights.notice && (
                <div className={styles.noticeCard}>
                  <AlertCircle size={20} className={styles.noticeIcon} />
                  <p>{data.flights.notice}</p>
                </div>
              )}

              <div className={styles.grid}>
                {flightsList.map((flight) => {
                  const saved = savedUrls.has(flight.id || flight.url);
                  return (
                    <div key={flight.id} className={styles.card}>
                      <div className={styles.cardHeader}>
                        <span className={styles.cardSource}>{flight.source}</span>
                        {flight.price !== null && (
                          <span className={styles.cardPrice}>{formatBRL(flight.price)}</span>
                        )}
                      </div>
                      <h3 className={styles.cardTitle}>{flight.title}</h3>
                      <p className={styles.cardDesc}>{flight.description}</p>
                      <div className={styles.cardActions}>
                        <button
                          type="button"
                          onClick={() => handleAddToBox(flight)}
                          className={saved ? styles.cardBtnSaved : styles.cardBtnPrimary}
                          disabled={saved}
                        >
                          {saved ? <Check size={16} /> : <Plus size={16} />}
                          <span>{saved ? 'Na Caixa' : 'Salvar na Caixa'}</span>
                        </button>
                        <a
                          href={flight.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          className={styles.cardBtnSecondary}
                        >
                          <span>Ver no Parceiro</span>
                          <ExternalLink size={14} />
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          )}

          {/* 2. ÔNIBUS & ROTAS TERRESTRES */}
          {(activeTab === 'all' || activeTab === 'transport') && (
            <section className={styles.categorySection}>
              <div className={styles.sectionHeader}>
                <div className={styles.sectionTitleGroup}>
                  <Bus size={22} className={styles.sectionIconTransport} />
                  <h2 className={styles.sectionTitle}>Ônibus, Rome2Rio & Rotas Terrestres</h2>
                </div>
                <span className={styles.sectionBadge}>Conexões Diretas</span>
              </div>

              <div className={styles.transportBanner}>
                <div className={styles.transportInfo}>
                  <h3>{cleanOrigin} → {cleanDest}</h3>
                  <p>Consulte itinerários combinados de ônibus rodoviário, trem, van ou transfer:</p>
                </div>
                <div className={styles.transportButtons}>
                  <a href={busLinks.rome2rio} target="_blank" rel="noopener noreferrer" className={styles.transportBtnPrimary}>
                    <ExternalLink size={16} /> Rome2Rio (Mapa & Rotas)
                  </a>
                  <a href={busLinks.clickbus} target="_blank" rel="noopener noreferrer" className={styles.transportBtn}>
                    <ExternalLink size={16} /> ClickBus
                  </a>
                  <a href={busLinks.deonibus} target="_blank" rel="noopener noreferrer" className={styles.transportBtn}>
                    <ExternalLink size={16} /> DeÔnibus
                  </a>
                  <a href={busLinks.buser} target="_blank" rel="noopener noreferrer" className={styles.transportBtn}>
                    <ExternalLink size={16} /> Buser
                  </a>
                </div>
              </div>
            </section>
          )}

          {/* 3. HOSPEDAGENS */}
          {(activeTab === 'all' || activeTab === 'hotels') && (
            <section className={styles.categorySection}>
              <div className={styles.sectionHeader}>
                <div className={styles.sectionTitleGroup}>
                  <Building2 size={22} className={styles.sectionIconHotel} />
                  <h2 className={styles.sectionTitle}>Hospedagens, Pousadas & Hotéis</h2>
                </div>
                <span className={styles.sectionBadge}>Booking.com Oficial</span>
              </div>

              <div className={styles.grid}>
                {hotelsList.map((hotel) => {
                  const saved = savedUrls.has(hotel.id || hotel.url);
                  return (
                    <div key={hotel.id} className={styles.card}>
                      <div className={styles.cardHeader}>
                        <span className={styles.cardSource}>{hotel.source}</span>
                      </div>
                      <h3 className={styles.cardTitle}>{hotel.title}</h3>
                      <p className={styles.cardDesc}>{hotel.description}</p>
                      <div className={styles.cardActions}>
                        <button
                          type="button"
                          onClick={() => handleAddToBox(hotel)}
                          className={saved ? styles.cardBtnSaved : styles.cardBtnPrimary}
                          disabled={saved}
                        >
                          {saved ? <Check size={16} /> : <Plus size={16} />}
                          <span>{saved ? 'Na Caixa' : 'Salvar na Caixa'}</span>
                        </button>
                        <a
                          href={hotel.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          className={styles.cardBtnSecondary}
                        >
                          <span>Buscar no Booking</span>
                          <ExternalLink size={14} />
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          )}

          {/* 4. PASSEIOS & ATRAÇÕES */}
          {(activeTab === 'all' || activeTab === 'tours') && (
            <section className={styles.categorySection}>
              <div className={styles.sectionHeader}>
                <div className={styles.sectionTitleGroup}>
                  <Ticket size={22} className={styles.sectionIconTour} />
                  <h2 className={styles.sectionTitle}>Passeios, Ingressos & Atrações Culturais</h2>
                </div>
                <span className={styles.sectionBadge}>Atrações & Agregadores</span>
              </div>

              <div className={styles.grid}>
                {toursList.map((tour) => {
                  const saved = savedUrls.has(tour.id || tour.url);
                  return (
                    <div key={tour.id} className={styles.card}>
                      <div className={styles.cardHeader}>
                        <span className={styles.cardSource}>{tour.source}</span>
                      </div>
                      <h3 className={styles.cardTitle}>{tour.title}</h3>
                      <p className={styles.cardDesc}>{tour.description}</p>
                      <div className={styles.cardActions}>
                        <button
                          type="button"
                          onClick={() => handleAddToBox(tour)}
                          className={saved ? styles.cardBtnSaved : styles.cardBtnPrimary}
                          disabled={saved}
                        >
                          {saved ? <Check size={16} /> : <Plus size={16} />}
                          <span>{saved ? 'Na Caixa' : 'Salvar na Caixa'}</span>
                        </button>
                        <a
                          href={tour.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          className={styles.cardBtnSecondary}
                        >
                          <span>Explorar no Parceiro</span>
                          <ExternalLink size={14} />
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          )}

          {/* 5. GARIMPO LIVRE */}
          {(activeTab === 'all' || activeTab === 'web') && (
            <section className={styles.categorySection}>
              <div className={styles.sectionHeader}>
                <div className={styles.sectionTitleGroup}>
                  <Globe size={22} className={styles.sectionIconWeb} />
                  <h2 className={styles.sectionTitle}>Garimpo Livre na Web</h2>
                </div>
                <span className={styles.sectionBadge}>Busca Aberta</span>
              </div>

              <div className={styles.webFallbackCard}>
                <p className={styles.webFallbackText}>
                  Pesquise diretamente nos principais motores para encontrar opções extras de lazer, gastronomia, roteiros e turismo em <strong>{cleanDest}</strong>:
                </p>

                <div className={styles.webFallbackButtons}>
                  <a
                    href={`https://www.google.com/search?q=${encodeURIComponent('o que fazer turismo e passeios em ' + cleanDest)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className={styles.engineBtn}
                  >
                    <ExternalLink size={15} /> Google
                  </a>
                  <a
                    href={`https://search.brave.com/search?q=${encodeURIComponent('turismo e dicas de viagem em ' + cleanDest)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className={styles.engineBtn}
                  >
                    <ExternalLink size={15} /> Brave Search
                  </a>
                  <a
                    href={`https://www.bing.com/search?q=${encodeURIComponent('guia de viagem e atracoes ' + cleanDest)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className={styles.engineBtn}
                  >
                    <ExternalLink size={15} /> Bing
                  </a>
                </div>

                <div className={styles.manualSaveBox}>
                  <span className={styles.manualSaveTitle}>Encontrou algo interessante na web? Cole aqui para salvar:</span>
                  <div className={styles.manualSaveInputs}>
                    <input
                      type="text"
                      placeholder="Título ou nome do achado (ex: Passeio de Barco / Restaurante X)"
                      value={manualTitle}
                      onChange={(e) => setManualTitle(e.target.value)}
                      className={styles.manualInput}
                    />
                    <input
                      type="url"
                      placeholder="https://..."
                      value={manualUrl}
                      onChange={(e) => setManualUrl(e.target.value)}
                      className={styles.manualInput}
                    />
                    <button
                      type="button"
                      onClick={() => {
                        if (!manualTitle.trim()) return setMessage({ type: 'error', text: 'Informe um título.' });
                        handleAddToBox({
                          id: `manual-${Date.now()}`,
                          category: 'tour',
                          source_type: 'curated',
                          source: 'Garimpo Livre',
                          title: manualTitle,
                          description: manualUrl || 'Link salvo manualmente do Garimpo Livre',
                          price: null,
                          currency: 'BRL',
                          url: manualUrl || `https://www.google.com/search?q=${encodeURIComponent(manualTitle)}`,
                        });
                        setManualTitle('');
                        setManualUrl('');
                      }}
                      className={styles.manualBtn}
                    >
                      <Plus size={16} /> Salvar na Caixa
                    </button>
                  </div>
                </div>
              </div>
            </section>
          )}
        </div>
      )}
    </main>
  );
}
