.header {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: rgba(234, 228, 217, 0.92);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1.5px solid var(--bg-sand-300);
  transition: background-color 0.25s ease, border-color 0.25s ease;
}

.container {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 1.5rem;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-size: 1.35rem;
  font-weight: 900;
  letter-spacing: -0.5px;
  color: var(--text-dark);
}

.logoIcon {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background-color: var(--brand-yellow);
  color: #1A1816;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0, 0, 0, 0.1);
}

.logoAccent {
  color: var(--brand-yellow);
}

.nav {
  display: flex;
  align-items: center;
  gap: 1.75rem;
}

.navLink {
  font-size: 0.92rem;
  font-weight: 700;
  color: var(--text-muted);
  transition: color 0.15s ease;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.navLink:hover {
  color: var(--text-dark);
}

.navLinkActive {
  color: var(--text-dark);
}

.actions {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.langBtn {
  padding: 0.45rem 0.85rem;
  border-radius: var(--radius-pill);
  background-color: var(--bg-sand-200);
  color: var(--text-dark);
  font-size: 0.8rem;
  font-weight: 800;
  border: 1.5px solid var(--bg-sand-300);
  transition: background-color 0.15s ease;
}

.langBtn:hover {
  background-color: var(--bg-sand-300);
}

.themeToggleBtn {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-pill);
  background-color: var(--bg-sand-200);
  color: var(--text-dark);
  font-size: 1rem;
  font-weight: 800;
  border: 1.5px solid var(--bg-sand-300);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.15s ease, transform 0.15s ease;
}

.themeToggleBtn:hover {
  background-color: var(--bg-sand-300);
  transform: rotate(15deg);
}

.authBtn {
  padding: 0.55rem 1.25rem;
  border-radius: var(--radius-pill);
  background-color: #1A1816;
  color: #FFFFFF;
  font-size: 0.88rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  transition: background-color 0.15s ease, transform 0.15s ease;
  border: 1.5px solid #1A1816;
}

.authBtn:hover {
  background-color: #332D27;
  transform: translateY(-1px);
}
