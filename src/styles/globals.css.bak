/* ==============================================================================
   GARIMPATRIP - CSS PURO GLOBAL & VARIÁVEIS DE DESIGN
   Fusão Layout 1 (Areia/Limpo) + Layout 3 (Bento Grid / Cores Modulares)
   ============================================================================== */

:root {
  /* Paleta Base Quente */
  --bg-sand-50: #FDFBF7;
  --bg-sand-100: #FAF7F2;
  --bg-sand-200: #F4EFE6;
  --bg-sand-300: #E8DEC8;

  --text-dark: #1E1E1E;
  --text-muted: #6B7280;
  --text-light: #9CA3AF;

  /* Amarelo Dourado Quente (GarimpaTrip) */
  --brand-yellow: #F5B731;
  --brand-yellow-hover: #E5A823;
  --brand-dark: #121212;
  --brand-amber: #D97706;

  --success: #059669;
  --danger: #DC2626;
  --danger-bg: #FEE2E2;

  /* Cores Modulares por Categoria (Layout 3) */
  --cat-flight-bg: #E3F2FD;
  --cat-flight-border: #90CAF9;
  --cat-flight-text: #1565C0;

  --cat-hotel-bg: #FFE0B2;
  --cat-hotel-border: #FFB74D;
  --cat-hotel-text: #E65100;

  --cat-tour-bg: #FFF9C4;
  --cat-tour-border: #FFF176;
  --cat-tour-text: #F57F17;

  --cat-transport-bg: #E8F5E9;
  --cat-transport-border: #A5D6A7;
  --cat-transport-text: #2E7D32;

  --cat-doc-bg: #EDE7F6;
  --cat-doc-border: #B39DDB;
  --cat-doc-text: #512DA8;

  --cat-food-bg: #FCE4EC;
  --cat-food-border: #F48FB1;
  --cat-food-text: #C2185B;

  --cat-money-bg: #E0F2F1;
  --cat-money-border: #80CBC4;
  --cat-money-text: #00695C;

  --cat-schedule-bg: #E1F5FE;
  --cat-schedule-border: #81D4FA;
  --cat-schedule-text: #0277BD;

  --cat-budget-bg: #F1F8E9;
  --cat-budget-border: #C5E1A5;
  --cat-budget-text: #558B2F;

  --cat-checklist-bg: #EFEBE9;
  --cat-checklist-border: #BCAAA4;
  --cat-checklist-text: #5D4037;

  /* Raios e Sombras */
  --radius-bento: 20px;
  --radius-card: 14px;
  --radius-pill: 9999px;

  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 25px -5px rgba(245, 183, 49, 0.2);
}

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html, body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: var(--bg-sand-100);
  color: var(--text-dark);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  cursor: pointer;
  border: none;
  background: none;
  font-family: inherit;
  color: inherit;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

input, select, textarea {
  font-family: inherit;
  font-size: 0.9rem;
}

:focus-visible {
  outline: 2px solid var(--brand-amber);
  outline-offset: 2px;
}

/* ==============================================================================
   COMPONENTES REUTILIZÁVEIS (prefixo gt-)
   ============================================================================== */

.gt-page {
  min-height: 100vh;
  background-color: var(--bg-sand-100);
}

.gt-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 4rem;
}

.gt-badge {
  display: inline-block;
  padding: 0.35rem 0.85rem;
  border-radius: var(--radius-pill);
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  border: 1px solid transparent;
}

.gt-title {
  font-size: 2.2rem;
  font-weight: 900;
  color: var(--brand-dark);
  margin-top: 0.5rem;
  letter-spacing: -0.5px;
  line-height: 1.2;
}

.gt-subtitle {
  font-size: 0.95rem;
  color: var(--text-muted);
  max-width: 680px;
  margin-top: 0.25rem;
}

.gt-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.6rem 1.1rem;
  border-radius: 10px;
  font-size: 0.85rem;
  font-weight: 700;
  transition: background-color 0.15s ease, transform 0.1s ease;
  white-space: nowrap;
}

.gt-btn:active:not(:disabled) {
  transform: translateY(1px);
}

.gt-btn-dark {
  background-color: var(--brand-dark);
  color: #FFFFFF;
}

.gt-btn-dark:hover:not(:disabled) {
  background-color: #2D2D2D;
}

.gt-btn-yellow {
  background-color: var(--brand-yellow);
  color: var(--brand-dark);
}

.gt-btn-yellow:hover:not(:disabled) {
  background-color: var(--brand-yellow-hover);
}

.gt-btn-light {
  background-color: var(--bg-sand-200);
  color: var(--text-dark);
}

.gt-btn-light:hover:not(:disabled) {
  background-color: var(--bg-sand-300);
}

.gt-btn-danger {
  background-color: var(--danger-bg);
  color: var(--danger);
}

.gt-btn-sm {
  padding: 0.4rem 0.7rem;
  font-size: 0.75rem;
  border-radius: 8px;
}

.gt-input {
  width: 100%;
  padding: 0.6rem 0.8rem;
  border-radius: 10px;
  border: 1px solid var(--bg-sand-300);
  background-color: #FFFFFF;
  color: var(--text-dark);
}

.gt-input:focus {
  outline: none;
  border-color: var(--brand-yellow);
  box-shadow: 0 0 0 3px rgba(245, 183, 49, 0.25);
}

.gt-label {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  font-size: 0.7rem;
  font-weight: 800;
  color: var(--text-muted);
  text-transform: uppercase;
}

.gt-card {
  background-color: #FFFFFF;
  border: 1px solid var(--bg-sand-300);
  border-radius: var(--radius-card);
  padding: 1.25rem;
  box-shadow: var(--shadow-sm);
}

.gt-notice {
  padding: 1rem 1.25rem;
  border-radius: var(--radius-card);
  background-color: var(--bg-sand-50);
  border: 1px dashed var(--bg-sand-300);
  color: var(--text-muted);
  font-size: 0.85rem;
}

.gt-error {
  padding: 0.85rem 1.1rem;
  border-radius: var(--radius-card);
  background-color: var(--danger-bg);
  color: var(--danger);
  font-size: 0.85rem;
  font-weight: 600;
}

.gt-success {
  padding: 0.85rem 1.1rem;
  border-radius: var(--radius-card);
  background-color: #D1FAE5;
  color: #065F46;
  font-size: 0.85rem;
  font-weight: 600;
}

.gt-muted {
  color: var(--text-muted);
  font-size: 0.85rem;
}

.gt-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.gt-sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

@media (max-width: 720px) {
  .gt-container {
    padding: 1.5rem 1rem 3rem;
  }

  .gt-title {
    font-size: 1.7rem;
  }
}
