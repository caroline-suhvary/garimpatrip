/* ==============================================================================
   GARIMPATRIP - CSS PURO GLOBAL & DESIGN TOKENS CALIBRADOS
   Fusão Fiel: Layout 1 (Areia / Kraft / Café Quente) + Layout 3 (Bento Grid Modular)
   ============================================================================== */

:root {
  /* ==========================================
     PALETA BASE (Layout 1 - Areia Quente / Kraft)
     ========================================== */
  --bg-sand-50:  #FAF7F2;   /* Superfícies de cartões e inputs destacados */
  --bg-sand-100: #EAE4D9;   /* Fundo Geral da Página (firme, aconchegante, não-branco) */
  --bg-sand-200: #DFD8CC;   /* Containers secundários, divisórias, hover de botões */
  --bg-sand-300: #CFC7B9;   /* Bordas estruturadas, linhas separadoras visíveis */
  --bg-sand-400: #B8AE9D;   /* Bordas com ênfase */
  
  /* Tipografia Espresso Quente (alto contraste sem preto cirúrgico) */
  --text-dark:   #1A1816;   /* Títulos e textos de alto impacto */
  --text-muted:  #5C564E;   /* Textos secundários, legendas */
  --text-light:  #8A8276;   /* Detalhes sutis, placeholders */
  
  /* Amarelo Mostarda / Ouro Queimado (GarimpaTrip - Identidade) */
  --brand-yellow:       #E5A428;
  --brand-yellow-hover: #D69318;
  --brand-yellow-soft:  #F7E7C4;
  --brand-dark:         #1A1816;
  --brand-dark-hover:   #2C2722;
  
  /* ==========================================
     CORES BENTO GRID MODULAR (Layout 3)
     Cores pastéis encorpadas com alto contraste sobre o fundo areia
     ========================================== */
  --cat-flight-bg:     #DCEAF7;
  --cat-flight-border: #99BFE4;
  --cat-flight-text:   #12539A;
  
  --cat-hotel-bg:      #FBE1CA;
  --cat-hotel-border:  #EBB585;
  --cat-hotel-text:    #A34100;
  
  --cat-tour-bg:       #FCF2B8;
  --cat-tour-border:   #E4CE67;
  --cat-tour-text:     #8C6700;
  
  --cat-transport-bg:  #DBEFE0;
  --cat-transport-border: #9BC9A4;
  --cat-transport-text:#1A6623;
  
  --cat-doc-bg:        #E7DEFA;
  --cat-doc-border:    #B9A4E6;
  --cat-doc-text:      #4D22A6;
  
  --cat-food-bg:       #FAD9E4;
  --cat-food-border:   #E89BB4;
  --cat-food-text:     #9A1448;

  --cat-currency-bg:   #D6F4EC;
  --cat-currency-border: #8FE0CB;
  --cat-currency-text: #0B6B54;

  --cat-schedule-bg:   #E0F1FB;
  --cat-schedule-border: #9CD2F1;
  --cat-schedule-text: #0D5985;

  --cat-budget-bg:     #E5F6D8;
  --cat-budget-border: #A8DE88;
  --cat-budget-text:   #2B6808;

  --cat-checklist-bg:  #EBE6DC;
  --cat-checklist-border: #C2BAAB;
  --cat-checklist-text: #453E32;
  
  /* Raios e Sombras Estruturadas */
  --radius-bento: 22px;
  --radius-card:  16px;
  --radius-pill:  9999px;
  
  --border-bento: 1.5px solid rgba(26, 24, 22, 0.12);
  --border-strong: 1.5px solid #1A1816;
  
  --shadow-sm: 0 1px 3px rgba(26, 24, 22, 0.05);
  --shadow-md: 0 4px 14px rgba(26, 24, 22, 0.08);
  --shadow-lg: 0 12px 30px -4px rgba(26, 24, 22, 0.12);
  --shadow-card-hover: 0 10px 24px -2px rgba(26, 24, 22, 0.12);
}

/* ==============================================================================
   DARK MODE (Preparado via classe .dark ou data-theme="dark")
   ============================================================================== */
[data-theme="dark"], body.dark {
  --bg-sand-50:  #24211D;
  --bg-sand-100: #181614;   /* Fundo escuro quente (café escuro / carvão) */
  --bg-sand-200: #2D2823;
  --bg-sand-300: #3E3731;
  --bg-sand-400: #554D45;
  
  --text-dark:   #F5EFE6;
  --text-muted:  #B5ACA0;
  --text-light:  #7D7468;
  
  --brand-yellow:       #F0B138;
  --brand-yellow-hover: #FFAF1A;
  --brand-yellow-soft:  #3D3018;
  --brand-dark:         #FAF7F2;
  --brand-dark-hover:   #FFFFFF;
  
  --cat-flight-bg:     #132B42;
  --cat-flight-border: #23517A;
  --cat-flight-text:   #8AC4FF;
  
  --cat-hotel-bg:      #3D2511;
  --cat-hotel-border:  #6E441E;
  --cat-hotel-text:    #FFB373;
  
  --cat-tour-bg:       #383210;
  --cat-tour-border:   #695D1E;
  --cat-tour-text:     #FFE46B;
  
  --cat-transport-bg:  #14331C;
  --cat-transport-border: #255C33;
  --cat-transport-text:#8CE39D;
  
  --cat-doc-bg:        #291D42;
  --cat-doc-border:    #4A3475;
  --cat-doc-text:      #C8ACFF;
  
  --cat-food-bg:       #3B1724;
  --cat-food-border:   #6E2B43;
  --cat-food-text:     #FFA1C2;

  --cat-currency-bg:   #11362E;
  --cat-currency-border: #1F6354;
  --cat-currency-text: #7FEBD3;

  --cat-schedule-bg:   #123145;
  --cat-schedule-border: #21577A;
  --cat-schedule-text: #8AD2FF;

  --cat-budget-bg:     #1F3812;
  --cat-budget-border: #3A6321;
  --cat-budget-text:   #ABF279;

  --cat-checklist-bg:  #292520;
  --cat-checklist-border: #474037;
  --cat-checklist-text: #D6CEBF;

  --border-bento: 1.5px solid rgba(255, 255, 255, 0.1);
  --border-strong: 1.5px solid rgba(255, 255, 255, 0.25);
  
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 14px rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 12px 30px -4px rgba(0, 0, 0, 0.5);
  --shadow-card-hover: 0 10px 24px -2px rgba(0, 0, 0, 0.5);
}

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html, body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: var(--bg-sand-100);
  color: var(--text-dark);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  transition: background-color 0.25s ease, color 0.25s ease;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  cursor: pointer;
  border: none;
  background: none;
  font-family: inherit;
}
