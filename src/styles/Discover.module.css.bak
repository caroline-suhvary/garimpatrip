/* ==============================================================================
   GARIMPATRIP - TELA DE DESCOBRIR (RESULTADOS & BENTO GRID)
   Paleta: Areia/Creme (#FAF7F2, #F4EFE6) + Mostarda/Ouro (#F5B731, #D97706)
   Estilo: Bento Cards, cantos arredondados, botões-pílula, sombras suaves
   ============================================================================== */

.main {
  min-height: calc(100vh - 72px);
  padding: 2.5rem 1.5rem 5rem;
  max-width: 1280px;
  margin: 0 auto;
}

.searchHeader {
  margin-bottom: 2rem;
}

.title {
  font-size: 1.95rem;
  font-weight: 800;
  color: var(--text-primary, #1A1816);
  letter-spacing: -0.02em;
  margin: 0;
}

/* ==============================================================================
   BARRA DE PESQUISA BENTO
   ============================================================================== */
.searchSection {
  background: var(--bg-card, #FFFFFF);
  border: 1.5px solid var(--border-color, #E5DECE);
  border-radius: 20px;
  padding: 1.5rem;
  box-shadow: 0 10px 30px -10px rgba(26, 24, 22, 0.06);
  margin-bottom: 2.25rem;
}

.searchForm {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.inputsGrid {
  display: grid;
  grid-template-columns: 1.2fr 1.2fr 0.9fr 0.8fr;
  gap: 1rem;
}

@media (max-width: 1024px) {
  .inputsGrid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 640px) {
  .inputsGrid {
    grid-template-columns: 1fr;
  }
}

.inputField {
  background: var(--bg-sand-50, #FAF7F2);
  border: 1.5px solid var(--border-color, #E5DECE);
  border-radius: 14px;
  padding: 0.75rem 1rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  transition: all 0.2s ease;
}

.inputField:focus-within {
  border-color: #F5B731;
  background: #FFFFFF;
  box-shadow: 0 0 0 3px rgba(245, 183, 49, 0.15);
}

.inputContent {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.inputLabel {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted, #78716C);
  margin-bottom: 0.2rem;
}

.textInput {
  border: none;
  background: transparent;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-primary, #1A1816);
  outline: none;
  padding: 0;
  width: 100%;
}

.textInput::placeholder {
  color: #A8A29E;
  font-weight: 400;
}

.actionRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  padding-top: 0.75rem;
  border-top: 1px dashed var(--border-color, #E5DECE);
}

.tripPickerRow {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.searchBtn {
  background: linear-gradient(135deg, #F5B731 0%, #D97706 100%);
  color: #1A1816;
  font-weight: 700;
  font-size: 0.95rem;
  padding: 0.75rem 1.75rem;
  border: none;
  border-radius: 9999px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  box-shadow: 0 4px 14px rgba(217, 119, 6, 0.25);
  transition: all 0.2s ease;
  margin-left: auto;
}

.searchBtn:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(217, 119, 6, 0.35);
}

.searchBtn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* ==============================================================================
   TABS DE NAVEGAÇÃO ENTRE SEÇÕES
   ============================================================================== */
.navTabs {
  display: flex;
  gap: 0.5rem;
  overflow-x: auto;
  padding-bottom: 0.5rem;
  margin-bottom: 2rem;
  scrollbar-width: none;
}

.navTabs::-webkit-scrollbar {
  display: none;
}

.tabBtn {
  background: var(--bg-sand-50, #FAF7F2);
  color: var(--text-muted, #78716C);
  border: 1px solid var(--border-color, #E5DECE);
  border-radius: 9999px;
  padding: 0.55rem 1.15rem;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.tabBtn:hover {
  background: #FFFFFF;
  color: var(--text-primary, #1A1816);
  border-color: #D97706;
}

.tabActive {
  background: #1A1816 !important;
  color: #FFFDF9 !important;
  border-color: #1A1816 !important;
  box-shadow: 0 4px 12px rgba(26, 24, 22, 0.15);
}

/* ==============================================================================
   ÁREA DE RESULTADOS & SEÇÕES
   ============================================================================== */
.resultsArea {
  display: flex;
  flex-direction: column;
  gap: 2.75rem;
}

.categorySection {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.sectionHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.sectionTitleGroup {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.sectionTitle {
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--text-primary, #1A1816);
  letter-spacing: -0.01em;
  margin: 0;
}

.sectionBadge {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 0.25rem 0.65rem;
  border-radius: 9999px;
  background: #FEF3C7;
  color: #92400E;
  border: 1px solid #FDE68A;
}

.sectionIconFlight,
.sectionIconHotel,
.sectionIconTour,
.sectionIconTransport,
.sectionIconWeb {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sectionIconFlight {
  background: #E0F2FE;
  color: #0369A1;
}

.sectionIconHotel {
  background: #FEF3C7;
  color: #B45309;
}

.sectionIconTour {
  background: #DCFCE7;
  color: #15803D;
}

.sectionIconTransport {
  background: #F3E8FF;
  color: #7E22CE;
}

.sectionIconWeb {
  background: #FEE2E2;
  color: #B91C1C;
}

/* ==============================================================================
   BANNER INFORMATIVO / HUB AÉREO / NOTICES
   ============================================================================== */
.noticeCard {
  background: #FFFBEB;
  border: 1.5px solid #FDE68A;
  border-radius: 14px;
  padding: 1.1rem 1.25rem;
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  color: #92400E;
  font-size: 0.92rem;
  line-height: 1.5;
}

.noticeIcon {
  color: #D97706;
  flex-shrink: 0;
  margin-top: 0.15rem;
}

/* ==============================================================================
   BANNER DE ROTAS TERRESTRES & ROME2RIO
   ============================================================================== */
.transportBanner {
  background: linear-gradient(135deg, #FAF7F2 0%, #F4EFE6 100%);
  border: 1.5px solid var(--border-color, #E5DECE);
  border-radius: 18px;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.transportInfo {
  max-width: 600px;
}

.transportInfo h4 {
  font-size: 1.1rem;
  font-weight: 700;
  color: #1A1816;
  margin: 0 0 0.35rem;
}

.transportInfo p {
  font-size: 0.88rem;
  color: #57534E;
  margin: 0;
  line-height: 1.45;
}

.transportButtons {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.transportBtn {
  background: #FFFFFF;
  color: #1A1816;
  border: 1.5px solid var(--border-color, #E5DECE);
  border-radius: 9999px;
  padding: 0.6rem 1.15rem;
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  transition: all 0.2s ease;
}

.transportBtn:hover {
  border-color: #D97706;
  transform: translateY(-1px);
}

.transportBtnPrimary {
  background: #1A1816;
  color: #FFFDF9;
  border-color: #1A1816;
}

.transportBtnPrimary:hover {
  background: #2C2824;
  border-color: #2C2824;
}

/* ==============================================================================
   GRID BENTO DE CARDS DE RESULTADOS
   ============================================================================== */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.25rem;
}

.card {
  background: var(--bg-card, #FFFFFF);
  border: 1.5px solid var(--border-color, #E5DECE);
  border-radius: 16px;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 1rem;
  position: relative;
  transition: all 0.2s ease;
  box-shadow: 0 2px 8px rgba(26, 24, 22, 0.04);
}

.card:hover {
  transform: translateY(-2px);
  border-color: #F5B731;
  box-shadow: 0 8px 24px -6px rgba(245, 183, 49, 0.18);
}

.badgeTop {
  position: absolute;
  top: -10px;
  right: 14px;
  background: #1A1816;
  color: #FFFDF9;
  font-size: 0.65rem;
  font-weight: 700;
  padding: 0.2rem 0.55rem;
  border-radius: 9999px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.cardHeader {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.cardSource {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #D97706;
}

.cardTitle {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-primary, #1A1816);
  line-height: 1.35;
  margin: 0;
}

.cardDesc {
  font-size: 0.82rem;
  color: var(--text-muted, #78716C);
  line-height: 1.45;
  margin: 0;
}

.cardPrice {
  font-size: 1.15rem;
  font-weight: 800;
  color: #15803D;
  margin-top: 0.25rem;
}

.cardActions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: auto;
  padding-top: 0.75rem;
  border-top: 1px dashed var(--border-color, #E5DECE);
}

.cardBtnPrimary {
  flex: 1;
  background: var(--bg-sand-50, #FAF7F2);
  color: var(--text-primary, #1A1816);
  border: 1px solid var(--border-color, #E5DECE);
  border-radius: 10px;
  padding: 0.55rem 0.85rem;
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  transition: all 0.2s ease;
}

.cardBtnPrimary:hover {
  background: #F5B731;
  color: #1A1816;
  border-color: #D97706;
}

.cardBtnSecondary {
  background: transparent;
  color: var(--text-muted, #78716C);
  border: 1px solid var(--border-color, #E5DECE);
  border-radius: 10px;
  padding: 0.55rem 0.7rem;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  transition: all 0.2s ease;
}

.cardBtnSecondary:hover {
  background: #FFFFFF;
  color: #1A1816;
  border-color: #A8A29E;
}

.cardBtnSaved {
  background: #DCFCE7 !important;
  color: #15803D !important;
  border-color: #86EFAC !important;
}

/* ==============================================================================
   CARD DE FALLBACK DO GARIMPO LIVRE (MOTORES DE BUSCA)
   ============================================================================== */
.webFallbackCard {
  background: #FFFFFF;
  border: 1.5px solid var(--border-color, #E5DECE);
  border-radius: 16px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.webFallbackText {
  font-size: 0.95rem;
  color: #44403C;
  margin: 0;
  line-height: 1.5;
  font-weight: 500;
}

.webFallbackButtons {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.engineBtn {
  background: var(--bg-sand-50, #FAF7F2);
  color: #1A1816;
  border: 1.5px solid var(--border-color, #E5DECE);
  border-radius: 9999px;
  padding: 0.6rem 1.25rem;
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  transition: all 0.2s ease;
}

.engineBtn:hover {
  background: #FFFFFF;
  border-color: #F5B731;
  transform: translateY(-1px);
}

/* ==============================================================================
   BOX DE SALVAMENTO MANUAL NA CAIXA DE DESCOBERTAS
   ============================================================================== */
.manualSaveBox {
  margin-top: 1.5rem;
  background: var(--bg-sand-50, #FAF7F2);
  border: 1.5px dashed var(--border-color, #E5DECE);
  border-radius: 14px;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.manualSaveTitle {
  font-size: 0.88rem;
  font-weight: 700;
  color: #1A1816;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.manualSaveInputs {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.manualInput {
  flex: 1;
  min-width: 220px;
  background: #FFFFFF;
  border: 1px solid var(--border-color, #E5DECE);
  border-radius: 10px;
  padding: 0.6rem 0.85rem;
  font-size: 0.85rem;
  color: #1A1816;
  outline: none;
}

.manualInput:focus {
  border-color: #F5B731;
}

.manualBtn {
  background: #1A1816;
  color: #FFFDF9;
  border: none;
  border-radius: 10px;
  padding: 0.6rem 1.15rem;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  transition: all 0.2s ease;
}

.manualBtn:hover {
  background: #2C2824;
}

/* ==============================================================================
   FEEDBACK & UTILITIES
   ============================================================================== */
.feedback {
  padding: 0.75rem 1rem;
  border-radius: 10px;
  font-size: 0.85rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.feedbackOk {
  background: #DCFCE7;
  color: #15803D;
  border: 1px solid #86EFAC;
}

.feedbackError {
  background: #FEE2E2;
  color: #B91C1C;
  border: 1px solid #FCA5A5;
}

.spin {
  animation: spinAnim 1s linear infinite;
}

@keyframes spinAnim {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ==============================================================================
   DARK THEME
   ============================================================================== */
[data-theme="dark"] .searchSection,
body.dark .searchSection,
[data-theme="dark"] .card,
body.dark .card,
[data-theme="dark"] .webFallbackCard,
body.dark .webFallbackCard {
  background: #24201C;
  border-color: #4A443D;
}

[data-theme="dark"] .inputField,
body.dark .inputField,
[data-theme="dark"] .tabBtn,
body.dark .tabBtn,
[data-theme="dark"] .manualSaveBox,
body.dark .manualSaveBox,
[data-theme="dark"] .cardBtnPrimary,
body.dark .cardBtnPrimary,
[data-theme="dark"] .engineBtn,
body.dark .engineBtn {
  background: #2C2824;
  border-color: #4A443D;
  color: #FAF7F2;
}

[data-theme="dark"] .transportBanner,
body.dark .transportBanner {
  background: #24201C;
  border-color: #4A443D;
}
