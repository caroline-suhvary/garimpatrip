.main {
  min-height: 100vh;
  background-color: var(--bg-sand-100);
}

.heroSection {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 3rem 1.5rem;
}

.heroBanner {
  position: relative;
  border-radius: var(--radius-bento);
  background: linear-gradient(135deg, #F5B731 0%, #F39C12 100%);
  padding: 3.5rem 3rem;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.heroTag {
  display: inline-block;
  padding: 0.35rem 1rem;
  border-radius: var(--radius-pill);
  background-color: rgba(18, 18, 18, 0.1);
  color: var(--brand-dark);
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 1.25rem;
}

.heroTitle {
  font-size: 3rem;
  font-weight: 900;
  color: var(--brand-dark);
  line-height: 1.15;
  letter-spacing: -1px;
  max-width: 750px;
  margin-bottom: 1rem;
}

.heroSubtitle {
  font-size: 1.15rem;
  font-weight: 500;
  color: rgba(18, 18, 18, 0.85);
  max-width: 650px;
}

.searchBar {
  margin-top: 2.5rem;
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 1.25rem;
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--bg-sand-300);
}

.searchForm {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 180px;
  gap: 1rem;
  align-items: center;
}

.inputField {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.6rem 1rem;
  background-color: var(--bg-sand-50);
  border-radius: 12px;
  border: 1px solid var(--bg-sand-300);
}

.inputContent {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.inputLabel {
  font-size: 0.65rem;
  font-weight: 800;
  color: var(--text-muted);
  text-transform: uppercase;
}

.textInput {
  border: none;
  background: transparent;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-dark);
  outline: none;
}

.searchBtn {
  height: 54px;
  background-color: var(--brand-dark);
  color: #FFFFFF;
  font-size: 1rem;
  font-weight: 800;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  transition: background-color 0.15s ease;
}

.searchBtn:hover {
  background-color: #2D2D2D;
}

/* BENTO GRID DAS 10 ÁREAS */
.bentoSection {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem 1.5rem 5rem 1.5rem;
}

.sectionHeader {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 2rem;
}

.sectionSub {
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted);
}

.sectionTitle {
  font-size: 1.85rem;
  font-weight: 900;
  color: var(--brand-dark);
  letter-spacing: -0.5px;
  margin-top: 0.25rem;
}

.sectionDesc {
  font-size: 0.9rem;
  color: var(--text-muted);
  max-width: 400px;
}

.bentoGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.bentoCard {
  border-radius: var(--radius-bento);
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 220px;
  border-width: 1px;
  border-style: solid;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.bentoCard:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}

.cardTop {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.iconBox {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background-color: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cardBadge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.25rem 0.65rem;
  border-radius: var(--radius-pill);
  background-color: rgba(255, 255, 255, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.9);
}

.cardTitle {
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--brand-dark);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cardDesc {
  font-size: 0.8rem;
  font-weight: 500;
  margin-top: 0.25rem;
  color: rgba(30, 30, 30, 0.8);
}

.bentoLink {
  color: inherit;
  display: contents;
}

.loginAlert {
  max-width: 1200px;
  margin: 1.5rem auto 0;
  padding: 0 1.5rem;
}

.howSection {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem 5rem;
}

.howGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.howStep {
  background-color: #FFFFFF;
  border: 1px solid var(--bg-sand-300);
  border-radius: var(--radius-bento);
  padding: 1.75rem;
}

.howNumber {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: var(--brand-yellow);
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0.75rem;
}

.howTitle {
  font-size: 1.05rem;
  font-weight: 800;
  margin-bottom: 0.25rem;
}

.footer {
  border-top: 1px solid var(--bg-sand-300);
  padding: 2rem 1.5rem;
  text-align: center;
  font-size: 0.8rem;
  color: var(--text-muted);
}

@media (max-width: 960px) {
  .searchForm {
    grid-template-columns: 1fr 1fr;
  }

  .bentoGrid,
  .howGrid {
    grid-template-columns: repeat(2, 1fr);
  }

  .heroTitle {
    font-size: 2.3rem;
  }

  .sectionHeader {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
}

@media (max-width: 600px) {
  .heroBanner {
    padding: 2rem 1.25rem;
  }

  .heroTitle {
    font-size: 1.8rem;
  }

  .searchForm,
  .bentoGrid,
  .howGrid {
    grid-template-columns: 1fr;
  }

  .bentoCard {
    height: auto;
    min-height: 180px;
    gap: 1.5rem;
  }
}
