// Provedores de busca da Caixa de Descobertas com Hub Inteligente, Cards de Atrações e Garimpo Livre (Brave/Web)
import { createClient } from '@supabase/supabase-js';
import { cityName, extractIata, resolveIata, getAirportAndHubInfo } from '@/lib/iata';
import type { SearchResponse, SearchResult } from '@/types';

function missingKey(key: string): SearchResponse {
  return { results: [], notice: `Chave ${key} não configurada no .env.local.` };
}

function failed(name: string): SearchResponse {
  return { results: [], notice: `Não foi possível carregar resultados de ${name} neste momento.` };
}

async function getJson<T>(url: string, headers?: HeadersInit): Promise<T> {
  const res = await fetch(url, { headers, next: { revalidate: 3600 } });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return (await res.json()) as T;
}

function getSupabaseAdmin() {
  const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
  const key = process.env.SUPABASE_SERVICE_ROLE_KEY || process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;
  if (!url || !key) return null;
  return createClient(url, key);
}

function logApiTelemetry(provider: string, endpoint: string, status: 'success' | 'error' | 'degraded_fallback', destination: string, durationMs: number, meta?: Record<string, any>) {
  // Telemetria silenciosa
}

/**
 * 1. PASSEIOS, INGRESSOS & ATRAÇÕES CULTURAIS
 * Utiliza OpenTripMap (/en/ e rate moderado) + Cards Curados e Prontos para Garimpar
 */
export async function searchTours(destination: string): Promise<SearchResponse> {
  const clean = cityName(destination).split(',')[0].trim();
  const key = process.env.OPENTRIPMAP_API_KEY;
  const t0 = Date.now();
  const results: SearchResult[] = [];

  // Tenta buscar atrações reais na OpenTripMap usando /en/
  if (key) {
    try {
      const geoUrl = `https://api.opentripmap.com/0.1/en/places/geoname?name=${encodeURIComponent(clean)}&apikey=${key}`;
      const geo = await getJson<{ lat?: number; lon?: number; status?: string }>(geoUrl);

      if (geo.lat !== undefined && geo.lon !== undefined) {
        const placesUrl = `https://api.opentripmap.com/0.1/en/places/radius?radius=15000&lon=${geo.lon}&lat=${geo.lat}&kinds=interesting_places&rate=1&format=json&limit=12&apikey=${key}`;
        const places = await getJson<{ xid: string; name: string; kinds: string; dist: number; rate: number }[]>(placesUrl);

        if (Array.isArray(places)) {
          for (const p of places) {
            if (!p.name || p.name.trim().length === 0) continue;
            const cleanKinds = p.kinds.split(',').slice(0, 3).map(k => k.replace(/_/g, ' ')).join(' • ');
            results.push({
              id: `otm-${p.xid}`,
              category: 'tour',
              source_type: 'api_partner',
              source: 'OpenTripMap',
              title: p.name,
              description: `${cleanKinds} • ${(p.dist / 1000).toFixed(1)} km do centro de ${clean}`,
              price: null,
              currency: 'BRL',
              url: `https://opentripmap.com/en/card/${p.xid}`,
              raw: { xid: p.xid, kinds: p.kinds, rate: p.rate },
            });
            if (results.length >= 8) break;
          }
        }
      }
    } catch (err) {
      console.warn('OpenTripMap falhou ou sem POIs locais, ativando cards de experiências:', err);
    }
  }

  // Cards de experiências prontos para garimpar (GetYourGuide, Civitatis, Tripadvisor, Viator)
  const curatedTours: SearchResult[] = [
    {
      id: `tour-cultural-${encodeURIComponent(clean)}`,
      category: 'tour',
      source_type: 'curated',
      source: 'GetYourGuide & Civitatis',
      title: `Tour Cultural, Pontos Turísticos & Roteiros em ${clean}`,
      description: `Roteiros guiados pelo centro histórico, mirantes, passeios culturais e histórias marcantes de ${clean}.`,
      price: null,
      currency: 'BRL',
      url: `https://www.getyourguide.com.br/s/?q=${encodeURIComponent(clean)}`,
    },
    {
      id: `tour-natureza-${encodeURIComponent(clean)}`,
      category: 'tour',
      source_type: 'curated',
      source: 'Civitatis & Viator',
      title: `Ecoturismo, Natureza, Trilhas & Parques de ${clean}`,
      description: `Passeios ao ar livre, cachoeiras, flutuações, praias ou trilhas ecológicas famosas na região de ${clean}.`,
      price: null,
      currency: 'BRL',
      url: `https://www.civitatis.com/br/busca?q=${encodeURIComponent(clean)}`,
    },
    {
      id: `tour-gastronomia-${encodeURIComponent(clean)}`,
      category: 'tour',
      source_type: 'curated',
      source: 'Tripadvisor',
      title: `Experiências Gastronômicas & Sabores Típicos em ${clean}`,
      description: `Onde provar os melhores pratos locais, restaurantes recomendados e experiências gastronômicas de ${clean}.`,
      price: null,
      currency: 'BRL',
      url: `https://www.tripadvisor.com.br/Search?q=${encodeURIComponent('restaurantes e passeios em ' + clean)}`,
    },
    {
      id: `tour-ingressos-${encodeURIComponent(clean)}`,
      category: 'tour',
      source_type: 'curated',
      source: 'Viator & GetYourGuide',
      title: `Passeios de 1 Dia, Ingressos & Atividades Populares`,
      description: `Ingressos sem fila, transfers para passeios da região e excursões imperdíveis em ${clean}.`,
      price: null,
      currency: 'BRL',
      url: `https://www.viator.com/searchResults/all?text=${encodeURIComponent(clean)}`,
    },
  ];

  if (results.length === 0) {
    results.push(...curatedTours);
  } else if (results.length < 4) {
    results.push(...curatedTours.slice(0, 4 - results.length));
  }

  logApiTelemetry('opentripmap', 'tours', 'success', destination, Date.now() - t0, { count: results.length });
  return { results };
}

/**
 * 2. PASSAGENS AÉREAS & VOOS
 * Consulta Travelpayouts / Google Flights pt-BR em BRL + Hub Aéreo Dinâmico
 */
export async function searchFlights(origin: string, destination: string, departMonth?: string): Promise<SearchResponse> {
  const token = process.env.TRAVELPAYOUTS_TOKEN || process.env.TRAVELPAYOUTS_API_KEY;
  const cleanDest = cityName(destination);
  const cleanOrigin = cityName(origin);

  const hubInfo = getAirportAndHubInfo(destination);

  if (!hubInfo.hasAirport) {
    const hubIata = hubInfo.hubIata || 'CGR';
    const hubName = hubInfo.hubName || 'polo regional mais próximo';
    const gfHubUrl = `https://www.google.com/travel/flights?q=voos+de+${encodeURIComponent(cleanOrigin)}+para+${encodeURIComponent(hubIata)}&hl=pt-BR&gl=BR&curr=BRL`;

    return {
      results: [
        {
          id: `flight-hub-${hubIata}`,
          category: 'flight',
          source_type: 'curated',
          source: 'Google Flights',
          title: `Voo até ${hubName} (Hub mais próximo)`,
          description: `Consulte voos saindo de ${cleanOrigin} até ${hubName} e complete a viagem por via terrestre.`,
          price: null,
          currency: 'BRL',
          url: gfHubUrl,
        }
      ],
      notice: hubInfo.notice,
    };
  }

  const origIata = (await resolveIata(origin)) || 'SAO';
  const destIata = hubInfo.iata || (await resolveIata(destination)) || 'SSA';

  const results: SearchResult[] = [];
  const gfSearchUrl = `https://www.google.com/travel/flights?q=voos+de+${encodeURIComponent(origIata)}+para+${encodeURIComponent(destIata)}&hl=pt-BR&gl=BR&curr=BRL`;

  if (token) {
    try {
      const monthParam = departMonth && /^\d{4}-\d{2}$/.test(departMonth) ? `&depart_date=${departMonth}` : '';
      const url = `https://api.travelpayouts.com/aviasales/v3/prices_for_dates?origin=${origIata}&destination=${destIata}&currency=BRL&locale=pt&unique=true&sorting=price${monthParam}&token=${token}`;
      const res = await fetch(url, { next: { revalidate: 1800 } });
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data.data) && data.data.length > 0) {
          for (const item of data.data.slice(0, 6)) {
            const price = Number(item.price);
            const depDate = item.departure_at ? new Date(item.departure_at).toLocaleDateString('pt-BR') : '';
            const retDate = item.return_at ? new Date(item.return_at).toLocaleDateString('pt-BR') : '';
            const datesText = retDate ? `Ida: ${depDate} • Volta: ${retDate}` : `Partida: ${depDate}`;
            const stopsText = item.transfers === 0 ? 'Voo direto' : `${item.transfers} parada(s)`;

            results.push({
              id: `tp-${item.flight_number || Math.random()}-${item.price}`,
              category: 'flight',
              source_type: 'api_partner',
              source: 'Google Flights & Aviasales',
              title: `${origIata} → ${destIata} • Cia ${item.airline || 'Aérea'}`,
              description: `${stopsText} • ${datesText}`,
              price: isNaN(price) ? null : price,
              currency: 'BRL',
              url: gfSearchUrl,
            });
          }
        }
      }
    } catch (err) {
      console.warn('Erro ao consultar Travelpayouts:', err);
    }
  }

  if (results.length === 0) {
    results.push({
      id: `flight-gf-${origIata}-${destIata}`,
      category: 'flight',
      source_type: 'curated',
      source: 'Google Flights',
      title: `Pesquisar Voos: ${origIata} → ${destIata}`,
      description: `Consulte preços em tempo real com tarifas em BRL saindo de ${cleanOrigin} para ${cleanDest}.`,
      price: null,
      currency: 'BRL',
      url: gfSearchUrl,
    });
  }

  return { results };
}

/**
 * 3. HOSPEDAGENS & POUSADAS
 * Booking.com com destino completo (cidade + estado + país)
 */
export async function searchHotels(destination: string): Promise<SearchResponse> {
  const fullDest = destination.trim();
  const clean = cityName(destination).split(',')[0].trim();
  const bookingUrl = `https://www.booking.com/searchresults.pt-br.html?ss=${encodeURIComponent(fullDest)}&lang=pt-br`;

  const results: SearchResult[] = [
    {
      id: `booking-pousadas-${encodeURIComponent(clean)}`,
      category: 'hotel',
      source_type: 'curated',
      source: 'Booking.com',
      title: `Pousadas & Hotéis em ${fullDest}`,
      description: `Pousadas charmosas e hotéis bem avaliados no centro e bairros nobres de ${clean}.`,
      price: null,
      currency: 'BRL',
      url: bookingUrl,
    },
    {
      id: `booking-economico-${encodeURIComponent(clean)}`,
      category: 'hotel',
      source_type: 'curated',
      source: 'Booking.com',
      title: `Hospedagens Econômicas & Custo-Benefício em ${clean}`,
      description: `Opções confortáveis que cabem no bolso para sua estadia em ${clean}.`,
      price: null,
      currency: 'BRL',
      url: `${bookingUrl}&order=price`,
    },
    {
      id: `booking-centro-${encodeURIComponent(clean)}`,
      category: 'hotel',
      source_type: 'curated',
      source: 'Booking.com',
      title: `Hospedagens com Café da Manhã & Melhor Localização`,
      description: `Filtro com notas altas de hóspedes e cancelamento grátis em ${clean}.`,
      price: null,
      currency: 'BRL',
      url: `${bookingUrl}&nflt=review_score%3D80`,
    },
  ];

  return { results };
}

/**
 * 4. TRANSPORTE TERRESTRE & ÔNIBUS
 */
export async function searchTransport(origin: string, destination: string): Promise<SearchResponse> {
  return { results: [] };
}

interface BraveResult {
  title: string;
  url: string;
  description: string;
}

/**
 * 5. GARIMPO LIVRE NA WEB (BRAVE SEARCH + FALLBACK DINÂMICO)
 * Export obrigatório para /api/discover/search e /api/discover/[provider]
 */
export async function searchWeb(destination: string): Promise<SearchResponse> {
  const clean = cityName(destination).split(',')[0].trim();
  const key = process.env.BRAVE_SEARCH_API_KEY;
  const admin = getSupabaseAdmin();

  const simulateQuota =
    process.env.BRAVE_SIMULATE_QUOTA === 'true' ||
    process.env.BRAVE_SIMULATE_QUOTA === '1' ||
    process.env.BRAVE_SIMULATE_QUOTA === 'TRUE';

  const fallbackUrls = {
    google: `https://www.google.com/search?q=${encodeURIComponent('o que fazer turismo e passeios em ' + clean)}`,
    brave: `https://search.brave.com/search?q=${encodeURIComponent('turismo e dicas de viagem em ' + clean)}`,
    bing: `https://www.bing.com/search?q=${encodeURIComponent('guia de viagem e atracoes ' + clean)}`,
  };

  const dynamicNotice = `Clique nos botões de pesquisa para encontrar mais opções de lazer e turismo em ${clean}.`;

  // Se estiver em simulação de cota ou sem chave configurada
  if (simulateQuota || !key) {
    return {
      results: [],
      notice: dynamicNotice,
      degraded: true,
      fallbackUrls,
    };
  }

  // Verificação de cota interna de 950 chamadas/mês se Supabase estiver ativo
  let allowed = true;
  if (admin) {
    try {
      const { data, error } = await admin.rpc('check_and_increment_api_quota', {
        p_provider: 'brave_search',
        p_limit: 950,
      });
      if (!error && data && typeof data === 'object' && 'allowed' in data) {
        allowed = Boolean((data as { allowed: boolean }).allowed);
      }
    } catch {
      allowed = true;
    }
  }

  if (!allowed) {
    logApiTelemetry('brave_search', 'search', 'degraded_fallback', clean, 0, { reason: 'monthly_quota_reached' });
    return {
      results: [],
      notice: dynamicNotice,
      degraded: true,
      fallbackUrls,
    };
  }

  // Executa busca na API do Brave Search
  const t0 = Date.now();
  try {
    const q = encodeURIComponent(`o que fazer em ${clean} dicas turismo roteiro`);
    const data = await getJson<{ web?: { results?: BraveResult[] } }>(
      `https://api.search.brave.com/res/v1/web/search?q=${q}&count=6&search_lang=pt`,
      { headers: { 'X-Subscription-Token': key, Accept: 'application/json' } }
    );

    const results = (data.web?.results ?? []).map<SearchResult>((r, i) => ({
      id: `brave-${i}-${Date.now()}`,
      category: 'tour',
      source_type: 'curated',
      source: 'Brave Search',
      title: r.title,
      description: r.description,
      price: null,
      currency: 'BRL',
      url: r.url,
    }));

    logApiTelemetry('brave_search', 'search', 'success', clean, Date.now() - t0, { count: results.length });
    return { results, fallbackUrls };
  } catch (err) {
    logApiTelemetry('brave_search', 'search', 'error', clean, Date.now() - t0);
    return {
      results: [],
      notice: dynamicNotice,
      degraded: true,
      fallbackUrls,
    };
  }
}
